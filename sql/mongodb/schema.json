{
    "database": "expai",
    "comment": "expai (Exponential Intelligence) on MongoDB: the collections and indexes the kernel's MongoDB schema handler (expMongoSchema) creates from share/db_schema.dba; bin/php/expaischema.php --install does it in a running installation.",
    "collections": [
        {
            "name": "expai_conversation",
            "indexes": [
                { "keys": { "id": 1 }, "options": { "unique": true, "name": "PRIMARY" } },
                { "keys": { "user_id": 1, "node_id": 1 }, "options": { "name": "expai_conversation_user_node" } }
            ]
        },
        {
            "name": "expai_draft_log",
            "indexes": [
                { "keys": { "id": 1 }, "options": { "unique": true, "name": "PRIMARY" } },
                { "keys": { "contentobject_id": 1, "version": 1 }, "options": { "name": "expai_draft_log_object" } },
                { "keys": { "user_id": 1, "status": 1 }, "options": { "name": "expai_draft_log_user" } },
                { "keys": { "node_id": 1 }, "options": { "name": "expai_draft_log_node" } }
            ]
        },
        {
            "name": "expai_usage_log",
            "indexes": [
                { "keys": { "id": 1 }, "options": { "unique": true, "name": "PRIMARY" } },
                { "keys": { "created": 1 }, "options": { "name": "expai_usage_log_created" } },
                { "keys": { "user_id": 1, "created": 1 }, "options": { "name": "expai_usage_log_user" } },
                { "keys": { "conversation_id": 1, "turn": 1 }, "options": { "name": "expai_usage_log_turn" } }
            ]
        }
    ]
}
