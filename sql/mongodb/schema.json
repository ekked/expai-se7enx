        {
            "name": "expai_usage_log",
            "indexes": [
                {
                    "keys": {
                        "id": 1
                    },
                    "options": {
                        "unique": true,
                        "name": "PRIMARY"
                    }
                },
                {
                    "keys": {
                        "created": 1
                    },
                    "options": {
                        "name": "expai_usage_log_created"
                    }
                },
                {
                    "keys": {
                        "provider": 1,
