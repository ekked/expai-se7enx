{
    "database": "expai",
    "comment": "expai (Exponential Intelligence) on MongoDB: the collections and indexes the kernel's MongoDB schema handler (expMongoSchema) creates from share/db_schema.dba; bin/php/expaischema.php --install does it in a running installation. Generated by bin/php/expaischema.php --write-files.",
    "collections": [
        {
            "name": "expai_batch",
            "indexes": [
                {
                    "keys": {
                        "id": 1
                    },
                    "options": {
                        "unique": true,
                        "name": "PRIMARY"
                    }
                },
                {
                    "keys": {
                        "state": 1,
                        "provider": 1
                    },
                    "options": {
                        "name": "expai_batch_state"
                    }
                }
            ]
        },
        {
            "name": "expai_change",
            "indexes": [
                {
                    "keys": {
                        "id": 1
                    },
                    "options": {
                        "unique": true,
                        "name": "PRIMARY"
                    }
                },
                {
                    "keys": {
                        "thread_id": 1,
                        "decision": 1
                    },
                    "options": {
                        "name": "expai_change_thread"
                    }
                },
                {
                    "keys": {
                        "contentobject_id": 1,
                        "language_code": 1
                    },
                    "options": {
                        "name": "expai_change_object"
                    }
                },
                {
                    "keys": {
                        "created": 1
                    },
                    "options": {
                        "name": "expai_change_created"
                    }
                }
            ]
        },
        {
            "name": "expai_checkpoint",
            "indexes": [
                {
                    "keys": {
                        "id": 1
                    },
                    "options": {
                        "unique": true,
                        "name": "PRIMARY"
                    }
                },
                {
                    "keys": {
                        "thread_id": 1,
                        "turn": 1
                    },
                    "options": {
                        "name": "expai_checkpoint_thread"
                    }
                },
                {
                    "keys": {
                        "created": 1
                    },
                    "options": {
                        "name": "expai_checkpoint_created"
                    }
                }
            ]
        },
        {
            "name": "expai_conversation",
            "indexes": [
                {
                    "keys": {
                        "id": 1
                    },
                    "options": {
                        "unique": true,
                        "name": "PRIMARY"
                    }
                },
                {
                    "keys": {
                        "user_id": 1,
                        "node_id": 1
